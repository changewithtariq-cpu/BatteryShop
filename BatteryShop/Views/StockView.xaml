<UserControl x:Class="BatteryShop.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Stock" Style="{StaticResource PageTitle}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Add opening / second-hand stock" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
                <Button Content="New purchase" Click="Purchase_Click" Margin="0"/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="Tabs" Background="White">
            <TabItem Header="  Stock by model  ">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Bottom" x:Name="SummaryText" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    <DataGrid x:Name="ModelStockGrid" IsReadOnly="True" MouseDoubleClick="ModelStockGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="140"/>
                            <DataGridTextColumn Header="Model" Binding="{Binding ModelName}" Width="*"/>
                            <DataGridTextColumn Header="Ah" Binding="{Binding CapacityAh}" Width="60"/>
                            <DataGridTextColumn Header="New" Binding="{Binding NewInStock}" Width="80"/>
                            <DataGridTextColumn Header="Second-hand" Binding="{Binding SecondHandInStock}" Width="100"/>
                            <DataGridTextColumn Header="Value at cost" Binding="{Binding StockValueAtCost, StringFormat=N0}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="LOW" Foreground="{StaticResource DangerBrush}" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="  Individual batteries  ">
                <DockPanel Margin="10">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <ComboBox x:Name="FilterModel" Width="240" Margin="0,0,8,0" SelectionChanged="Filter_Changed"/>
                        <ComboBox x:Name="FilterCondition" Width="120" Margin="0,0,8,0" SelectionChanged="Filter_Changed"/>
                        <ComboBox x:Name="FilterStatus" Width="120" Margin="0,0,8,0" SelectionChanged="Filter_Changed"/>
                        <TextBox x:Name="SearchBox" Width="180" Margin="0,0,8,0" ToolTip="Search serial number" TextChanged="Search_TextChanged"/>
                        <Button Content="Edit serial" Click="EditSerial_Click"/>
                        <Button Content="Set sale price" Click="SetPrice_Click"/>
                        <Button Content="Remove from stock" Style="{StaticResource DangerButton}" Click="Remove_Click"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="UnitCountText" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    <DataGrid x:Name="UnitGrid" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Battery" Binding="{Binding ModelDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Serial no." Binding="{Binding SerialNo}" Width="140"/>
                            <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="95"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding ConditionNote}" Width="140"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80"/>
                            <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost, StringFormat=N0}" Width="85" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Sale price" Binding="{Binding SuggestedPrice, StringFormat=N0}" Width="85" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Received" Binding="{Binding ReceivedDate}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

<UserControl x:Class="BatteryShop.Views.NewSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== LEFT: customer, batteries, exchange ===================== -->
        <DockPanel Margin="0,0,14,0">
            <TextBlock DockPanel.Dock="Top" Text="New Sale" Style="{StaticResource PageTitle}"/>

            <!-- Customer -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,8">
                <DockPanel>
                    <TextBlock Text="Customer" VerticalAlignment="Center" FontWeight="SemiBold" Width="80"/>
                    <Button DockPanel.Dock="Right" Content="+ New customer" Margin="0" Click="NewCustomer_Click"/>
                    <Button DockPanel.Dock="Right" Content="Walk-in" Click="WalkIn_Click"/>
                    <TextBlock DockPanel.Dock="Right" x:Name="CustomerBalanceText" VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CustomerBox" IsEditable="True" IsTextSearchEnabled="True" Margin="0,0,8,0"
                              SelectionChanged="CustomerBox_SelectionChanged"
                              ToolTip="Type name or phone and pick from the list"/>
                </DockPanel>
            </Border>

            <!-- Find battery (smart search) -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Text="Find battery" VerticalAlignment="Center" FontWeight="SemiBold" Width="80"/>
                        <TextBlock DockPanel.Dock="Right" x:Name="ResultCountText" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="SearchBox" FontSize="15" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                 ToolTip="Type anything: brand, model, Ah, serial (e.g. ags 60, sp70, volta). Scan a serial and press Enter."/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="80,3,0,4"
                               Text="Type to filter  |  Enter or double-click adds the battery  |  Down arrow moves into the list"/>
                    <DataGrid x:Name="ResultsGrid" IsReadOnly="True" Height="165" MouseDoubleClick="ResultsGrid_MouseDoubleClick"
                              PreviewKeyDown="ResultsGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Battery" Binding="{Binding ModelDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Serial no." Binding="{Binding SerialNo}" Width="130"/>
                            <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="90"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding ConditionNote}" Width="120"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding SuggestedPrice, StringFormat=N0, Mode=OneWay}" Width="85" ElementStyle="{StaticResource RightCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Old battery exchange -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="Old battery exchange (optional)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Description (brand / Ah)" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                            <TextBox x:Name="ExDesc" Text="Old battery"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Weight (kg)" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                            <TextBox x:Name="ExWeight" Style="{StaticResource DecimalBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Value (Rs)" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                            <TextBox x:Name="ExValue" Style="{StaticResource AmountBox}"/>
                        </StackPanel>
                        <Button Grid.Column="3" Content="Add old battery" VerticalAlignment="Bottom" Margin="0" Click="AddExchange_Click"/>
                    </Grid>
                    <DataGrid x:Name="ExchangeGrid" IsReadOnly="True" MaxHeight="110" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Old battery" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Weight kg" Binding="{Binding WeightKg}" Width="90"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding ExchangeValue, StringFormat=N0}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Padding="6,0" MinHeight="22" Margin="0" Style="{StaticResource DangerButton}" Click="RemoveExchange_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Bill lines -->
            <Border Style="{StaticResource Card}" Padding="12,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Batteries on this bill  (you can change Price, Discount and Warranty in the grid)"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                    <DataGrid x:Name="LinesGrid" CanUserSortColumns="False" CellEditEnding="LinesGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Battery" Binding="{Binding Description, Mode=OneWay}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Serial" Binding="{Binding SerialNo, Mode=OneWay}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Cond." Binding="{Binding Condition, Mode=OneWay}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="90" EditingElementStyle="{StaticResource GridIntEdit}"/>
                            <DataGridTextColumn Header="Discount" Binding="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" Width="80" EditingElementStyle="{StaticResource GridIntEdit}"/>
                            <DataGridTextColumn Header="Warranty (mo)" Binding="{Binding WarrantyMonths, UpdateSourceTrigger=PropertyChanged}" Width="95" EditingElementStyle="{StaticResource GridIntEdit}"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N0, Mode=OneWay}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Padding="6,0" MinHeight="22" Margin="0" Style="{StaticResource DangerButton}" Click="RemoveLine_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ===================== RIGHT: totals & payment ===================== -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="Save &amp; Print  (F9)" Style="{StaticResource PrimaryButton}" FontSize="15" MinHeight="44" Margin="0,0,0,8" Click="SavePrint_Click"/>
                    <Button Content="Save without printing" Margin="0,0,0,8" Click="Save_Click"/>
                    <Button Content="Clear bill" Style="{StaticResource DangerButton}" Margin="0" Click="Clear_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Bill summary" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,4">
                        <TextBlock Text="Sub total"/>
                        <TextBlock x:Name="SubTotalText" HorizontalAlignment="Right" FontWeight="SemiBold" Text="0"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="Bill discount" VerticalAlignment="Center"/>
                        <TextBox x:Name="DiscountBox" Width="120" HorizontalAlignment="Right" Style="{StaticResource AmountBox}" Text="0" TextChanged="Amount_Changed"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="Old battery exchange"/>
                        <TextBlock x:Name="ExchangeText" HorizontalAlignment="Right" FontWeight="SemiBold" Text="0"/>
                    </Grid>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8"/>
                    <TextBlock Text="NET TOTAL" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="NetText" Text="Rs. 0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>

                    <TextBlock Text="Paid now" Style="{StaticResource Label}" Margin="0,12,0,2"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Full" Margin="6,0,0,0" Click="FullPaid_Click"/>
                        <TextBox x:Name="PaidBox" Style="{StaticResource AmountBox}" FontSize="18" Text="0" TextChanged="Amount_Changed"/>
                    </DockPanel>
                    <TextBlock Text="Payment method" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="MethodBox"/>

                    <TextBlock Text="Remaining (credit)" Style="{StaticResource Label}" Margin="0,12,0,0"/>
                    <TextBlock x:Name="RemainingText" Text="Rs. 0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock x:Name="PaymentTypeText" Foreground="{StaticResource MutedBrush}"/>

                    <TextBlock Text="Notes" Style="{StaticResource Label}" Margin="0,12,0,2"/>
                    <TextBox x:Name="NotesBox"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="BatteryShop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings &amp; Backup" Style="{StaticResource PageTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Shop & receipt -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Shop details (printed on receipts)" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Shop name" Style="{StaticResource Label}"/>
                        <TextBox x:Name="ShopName"/>
                        <TextBlock Text="Address" Style="{StaticResource Label}"/>
                        <TextBox x:Name="Address" AcceptsReturn="True" Height="52" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                        <TextBlock Text="Phone" Style="{StaticResource Label}"/>
                        <TextBox x:Name="Phone"/>
                        <TextBlock Text="Receipt footer (warranty terms)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="Footer" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalContentAlignment="Top"/>

                        <TextBlock Text="Receipt printer (80mm)" Style="{StaticResource Label}" Margin="0,14,0,2"/>
                        <ComboBox x:Name="PrinterBox"/>
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="If no printer is selected, receipts are shown on screen first and Windows asks which printer to use."/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                            <Button Content="Print test receipt" Click="TestPrint_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Backup -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Backup" Style="{StaticResource SectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="A backup is made automatically once a day when the app opens or closes. Keep the backup folder on a USB drive or a second disk if possible, so a PC failure doesn't lose your data."/>
                        <TextBlock Text="Backup folder" Style="{StaticResource Label}" Margin="0,10,0,2"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse..." Margin="6,0,0,0" Click="Browse_Click"/>
                            <TextBox x:Name="BackupFolder"/>
                        </DockPanel>
                        <TextBlock x:Name="LastBackupText" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Backup now" Style="{StaticResource PrimaryButton}" Click="BackupNow_Click"/>
                            <Button Content="Open backup folder" Click="OpenFolder_Click"/>
                        </StackPanel>

                        <TextBlock Text="Restore" Style="{StaticResource SectionTitle}" Margin="0,22,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="Replaces ALL current data with a backup file. A safety copy of the current data is made first. The app closes after restoring; open it again."/>
                        <Button Content="Restore from backup..." Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Restore_Click"/>

                        <TextBlock Text="Database location" Style="{StaticResource Label}" Margin="0,22,0,2"/>
                        <TextBox x:Name="DbPathText" IsReadOnly="True" Background="#F6F8FA"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

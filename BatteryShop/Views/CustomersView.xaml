<UserControl x:Class="BatteryShop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Customers" Style="{StaticResource PageTitle}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Receive payment" Style="{StaticResource PrimaryButton}" Click="Receive_Click"/>
                            <Button Content="Statement" Click="Statement_Click"/>
                            <Button Content="Bills" Click="Bills_Click" Margin="0"/>
                        </StackPanel>
                        <TextBox x:Name="SearchBox" Width="240" HorizontalAlignment="Left" TextChanged="Search_TextChanged"
                                 ToolTip="Search by name or phone"/>
                        <CheckBox x:Name="OnlyBalance" Content="Only with balance" Margin="10,0" Checked="Reload" Unchecked="Reload"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="TotalText" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    <DataGrid x:Name="CustomerGrid" IsReadOnly="True" SelectionChanged="CustomerGrid_SelectionChanged" MouseDoubleClick="Statement_Click">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                            <DataGridTextColumn Header="Vehicle / use" Binding="{Binding VehicleInfo}" Width="140"/>
                            <DataGridTextColumn Header="Balance (Rs)" Binding="{Binding Balance, StringFormat=N0}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="FormTitle" Text="New customer" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Name *" Style="{StaticResource Label}"/>
                    <TextBox x:Name="FName"/>
                    <TextBlock Text="Phone" Style="{StaticResource Label}"/>
                    <TextBox x:Name="FPhone" Style="{StaticResource PhoneBox}"/>
                    <TextBlock Text="Address" Style="{StaticResource Label}"/>
                    <TextBox x:Name="FAddress"/>
                    <TextBlock Text="Vehicle / use (car, UPS, solar...)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="FVehicle"/>
                    <TextBlock Text="Opening balance (old amount customer owes)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="FOpening" Style="{StaticResource AmountBox}" Text="0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                        <Button Content="New" Click="New_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="BatteryShop.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Purchases (stock in from dealers)" Style="{StaticResource PageTitle}"/>
        <TabControl x:Name="Tabs" Background="White">
            <!-- ======================= New purchase ======================= -->
            <TabItem Header="  New purchase  ">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Supplier *" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="SupplierBox" Width="240"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Dealer bill no." Style="{StaticResource Label}"/>
                            <TextBox x:Name="BillNoBox" Width="150"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Date" Style="{StaticResource Label}"/>
                            <DatePicker x:Name="DateBox" Width="140"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Notes" Style="{StaticResource Label}"/>
                            <TextBox x:Name="NotesBox" Width="250"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Line entry -->
                    <Border Grid.Row="1" Background="#F6F8FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="10" Margin="0,12,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Battery model" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="LineModel" IsEditable="True" SelectionChanged="LineModel_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Qty" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                                <TextBox x:Name="LineQty" Style="{StaticResource IntBox}" Text="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Cost each *" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                                <TextBox x:Name="LineCost" Style="{StaticResource AmountBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Serial numbers (comma or space separated, optional)" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                                <TextBox x:Name="LineSerials"/>
                            </StackPanel>
                            <Button Grid.Column="4" Content="Add line" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                    Margin="0" Click="AddLine_Click"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2" x:Name="LinesGrid" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Battery" Binding="{Binding Model.DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTextColumn Header="Cost each" Binding="{Binding UnitCost, StringFormat=N0}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N0}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Serials" Binding="{Binding Serials}" Width="220"/>
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Padding="6,0" MinHeight="22" Margin="0" Style="{StaticResource DangerButton}" Click="RemoveLine_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Totals -->
                    <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Sub total" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="SubTotalText" FontSize="16" FontWeight="SemiBold" Text="0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Discount" Style="{StaticResource Label}"/>
                                <TextBox x:Name="DiscountBox" Width="100" Style="{StaticResource AmountBox}" Text="0" TextChanged="Totals_Changed"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Bill total" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="NetText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Paid now" Style="{StaticResource Label}"/>
                                <TextBox x:Name="PaidBox" Width="110" Style="{StaticResource AmountBox}" Text="0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Method" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="MethodBox" Width="120"/>
                            </StackPanel>
                            <Button Content="Save purchase" Style="{StaticResource PrimaryButton}" Click="Save_Click" MinHeight="36" Margin="0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Left" Content="Clear" VerticalAlignment="Bottom" Click="Clear_Click"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ======================= History ======================= -->
            <TabItem Header="  Purchase history  ">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="FromDate" Width="130"/>
                        <TextBlock Text="To" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <DatePicker x:Name="ToDate" Width="130" Margin="0,0,10,0"/>
                        <Button Content="Show" Click="ShowHistory_Click"/>
                        <Button Content="Cancel purchase" Style="{StaticResource DangerButton}" Click="Void_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="HistoryTotal" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    <DataGrid x:Name="HistoryGrid" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Purchase no." Binding="{Binding PurchaseNo}" Width="110"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding PurchaseDate}" Width="150"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
                            <DataGridTextColumn Header="Dealer bill" Binding="{Binding SupplierInvoiceNo}" Width="110"/>
                            <DataGridTextColumn Header="Batteries" Binding="{Binding Items}" Width="80"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding NetTotal, StringFormat=N0}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

<Window x:Class="BatteryShop.Views.LedgerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Statement" Width="820" Height="600" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" FontSize="13" FontFamily="Segoe UI">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" Margin="0"/>
            <TextBlock x:Name="SubText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="FromDate" Width="130"/>
                <TextBlock Text="To" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <DatePicker x:Name="ToDate" Width="130" Margin="0,0,10,0"/>
                <Button Content="Show" Click="Show_Click"/>
                <Button Content="All time" Click="All_Click"/>
                <Button Content="Print" Click="Print_Click"/>
            </StackPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,8">
            <TextBlock x:Name="ClosingText" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        </Border>
        <DataGrid x:Name="LedgerGrid" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding TxnDate}" Width="150"/>
                <DataGridTextColumn Header="Type" Binding="{Binding TxnType}" Width="130"/>
                <DataGridTextColumn Header="Reference" Binding="{Binding RefNo}" Width="*"/>
                <DataGridTextColumn x:Name="DebitCol" Header="Debit" Binding="{Binding Debit, StringFormat=N0}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn x:Name="CreditCol" Header="Credit" Binding="{Binding Credit, StringFormat=N0}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N0}" Width="110" ElementStyle="{StaticResource RightCell}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

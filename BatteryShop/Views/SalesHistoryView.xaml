<UserControl x:Class="BatteryShop.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="TitleText" Text="Sales History" Style="{StaticResource PageTitle}"/>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="FromDate" Width="130"/>
            <TextBlock Text="To" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <DatePicker x:Name="ToDate" Width="130" Margin="0,0,10,0"/>
            <TextBox x:Name="SearchBox" Width="220" Margin="0,0,10,0" ToolTip="Bill no, customer, phone or serial number" KeyDown="SearchBox_KeyDown"/>
            <Button Content="Show" Style="{StaticResource PrimaryButton}" Click="Show_Click"/>
            <Button Content="Today" Click="Today_Click"/>
            <Button Content="This month" Click="Month_Click"/>
        </WrapPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="View / Reprint receipt" Style="{StaticResource PrimaryButton}" Click="Reprint_Click"/>
                    <Button Content="Cancel sale" Style="{StaticResource DangerButton}" Click="Void_Click"/>
                </StackPanel>
                <TextBlock x:Name="TotalsText" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <DataGrid x:Name="SalesGrid" IsReadOnly="True" MouseDoubleClick="Reprint_Click">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Bill no." Binding="{Binding InvoiceNo}" Width="105"/>
                <DataGridTextColumn Header="Date" Binding="{Binding SaleDate}" Width="160"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="115"/>
                <DataGridTextColumn Header="Net total" Binding="{Binding NetTotal, StringFormat=N0}" Width="95" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat=N0}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="Profit" Binding="{Binding GrossProfit, StringFormat=N0}" Width="85" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="Type" Binding="{Binding PaymentType}" Width="70"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Voided">
                            <Setter Property="Foreground" Value="#999999"/>
                            <Setter Property="FontStyle" Value="Italic"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</UserControl>

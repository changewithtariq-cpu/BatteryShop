<Window x:Class="BatteryShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayaz Battery &amp; Solar Service" Height="760" Width="1280" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontSize="13" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Background="{StaticResource SidebarBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="18,20,12,20">
                <TextBlock Text="AYAZ" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Battery &amp; Solar Service" Foreground="#9FB3C8" FontSize="12"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Foreground="#6F8399" FontSize="11" Margin="18,10"/>
            <StackPanel>
                <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Content="Dashboard   (F1)" Tag="Dashboard" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSale" Style="{StaticResource NavButton}" Content="New Sale   (F2)" Tag="NewSale" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSales" Style="{StaticResource NavButton}" Content="Sales History   (F3)" Tag="Sales" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavCustomers" Style="{StaticResource NavButton}" Content="Customers   (F4)" Tag="Customers" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavStock" Style="{StaticResource NavButton}" Content="Stock   (F5)" Tag="Stock" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavPurchases" Style="{StaticResource NavButton}" Content="Purchases   (F6)" Tag="Purchases" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSuppliers" Style="{StaticResource NavButton}" Content="Suppliers" Tag="Suppliers" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavModels" Style="{StaticResource NavButton}" Content="Battery Models" Tag="Models" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Settings &amp; Backup" Tag="Settings" Checked="Nav_Checked"/>
            </StackPanel>
        </DockPanel>

        <!-- Page area -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="22,18,22,18" Focusable="False"/>
    </Grid>
</Window>
